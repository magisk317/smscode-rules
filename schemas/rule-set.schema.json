{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magisk317/smscode-rules/schemas/rule-set.schema.json",
  "title": "SmsCode Rule Set",
  "type": "object",
  "required": [
    "specVersion",
    "id",
    "name",
    "locale",
    "updatedAt",
    "rules"
  ],
  "properties": {
    "specVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "codeKeyword",
          "codeRegex",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": [
              "string",
              "null"
            ]
          },
          "codeKeyword": {
            "type": "string",
            "minLength": 1
          },
          "codeRegex": {
            "type": "string",
            "minLength": 1
          },
          "senderRegex": {
            "type": [
              "string",
              "null"
            ]
          },
          "packageNameHint": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "body",
                "expectedCode"
              ],
              "properties": {
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedCode": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

