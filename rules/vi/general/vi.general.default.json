{
  "specVersion": 1,
  "id": "vi.general.default",
  "name": "Quy tắc mã xác minh chung (tiếng Việt)",
  "description": "越南语短信验证码兜底规则。bare「ma」在字面量包含匹配下过宽（gmail/shipping 等误锚定），不放目录；otp 由 global 集覆盖。",
  "locale": "vi",
  "updatedAt": "2026-10-06T00:58:10+08:00",
  "rules": [
    {
      "id": "vi-default-numeric-ma",
      "company": null,
      "codeKeyword": "mã",
      "codeRegex": "(?<![a-zA-Z0-9])[0-9]{4,8}(?![a-zA-Z0-9])",
      "priority": 10,
      "rejectedSuffixes": [
        "mb",
        "gb",
        "kb",
        "tb",
        "vnd",
        "đ"
      ],
      "notes": "越南语关键词兜底（mã）；带词边界的宽松词请走用户自定义关键词（BUILTIN 正则）。",
      "examples": [
        {
          "body": "Nhận mã xác minh 482910",
          "expectedCode": "482910"
        }
      ]
    },
    {
      "id": "vi-default-alphanumeric-ma",
      "company": null,
      "codeKeyword": "mã",
      "codeRegex": "(?<![a-zA-Z0-9])[a-zA-Z0-9]{4,8}(?![a-zA-Z0-9])",
      "priority": 5,
      "rejectedSuffixes": [
        "mb",
        "gb",
        "kb",
        "tb",
        "vnd",
        "đ"
      ],
      "notes": "越南语关键词兜底（mã）；带词边界的宽松词请走用户自定义关键词（BUILTIN 正则）。",
      "examples": [
        {
          "body": "Nhận mã xác minh AB12CD",
          "expectedCode": "AB12CD"
        }
      ]
    }
  ]
}
